{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Pages project. The build command (npm run build) is set in the Pages dashboard.
  "name": "rollcall",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  // Public project id (same value as VITE_FIREBASE_PROJECT_ID). ID tokens are checked against it.
  "vars": { "FIREBASE_PROJECT_ID": "rollcall-e85e8" },
  // Event photos. Create once with: npx wrangler r2 bucket create rollcall-photos
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "rollcall-photos" }]
}
