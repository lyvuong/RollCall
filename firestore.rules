rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember() {
      return signedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin flag: a user may only check their own doc; set manually in console.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Invitation codes: doc ID is the code. Must know the code to get it.
    match /invites/{code} {
      allow get: if signedIn();
      // Any member may see and create codes; only an admin may change or delete one.
      allow list: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['expiresAt', 'label', 'createdBy'])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Membership is granted by redeeming a valid, unexpired code.
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'email', 'name', 'redeemedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/invites/$(request.resource.data.code))
             .data.expiresAt > request.time;
      allow delete: if isAdmin();
      // An admin may set anyone's role.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['staff', 'volunteer'];
      // A member may only set their own display name and whether they are staff or a volunteer.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role'])
        && (!('role' in request.resource.data) || request.resource.data.role in ['staff', 'volunteer'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }

    // Who is staff or a volunteer, by display name, so every member's participants list can show it.
    // Kept in step with members/{uid}.role by the app: a member writes their own, an admin anyone's.
    match /roster/{uid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && (request.auth.uid == uid || isAdmin())
        && request.resource.data.keys().hasOnly(['name', 'role'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.role in ['staff', 'volunteer'];
      allow delete: if isAdmin();
    }

    match /locations/{id} {
      allow read: if isMember();
      allow write: if isMember();
    }

    match /people/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.type in ['osg', 'community', 'member', 'volunteer', 'both'];
      allow delete: if isMember();
    }

    // Copy of the Neon One account list (doc id = Neon account id), refreshed by the Settings sync.
    match /neonPeople/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.nameLower is string
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /appMeta/{id} {
      allow read: if isMember();
      allow write: if isMember();
    }

    // Collection-group reads of photo metadata (event list counts and thumbnails).
    match /{path=**}/photos/{photoId} {
      allow read: if isMember();
    }

    // Collection-group reads of reactions (poll results on the event list).
    match /{path=**}/reactions/{rid} {
      allow read: if isMember();
    }

    match /events/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.name is string
        && request.resource.data.format in ['virtual', 'in-person', 'both']
        && request.resource.data.endTime > request.resource.data.startTime;
      allow delete: if isMember();

      // Who has the event open right now: each member writes only their own marker, refreshed while the page is open.
      match /presence/{uid} {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'where', 'at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.where in ['participants', 'details']
          && request.resource.data.at == request.time;
        allow delete: if isMember() && request.auth.uid == uid;
      }

      // Photo metadata; the image files themselves live in R2 (see worker/index.js).
      match /photos/{photoId} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['uploadedBy', 'uploadedByName', 'uploadedAt', 'expireAt', 'width', 'height'])
          && request.resource.data.uploadedBy == request.auth.uid
          // Firestore TTL policy on `expireAt` deletes the doc; the client sets it ~30 days out.
          && request.resource.data.expireAt is timestamp
          && request.resource.data.expireAt <= request.time + duration.value(31, 'd');
        allow delete: if isMember();
      }

      // Anonymous reaction poll: one doc per tap (1/0/0) or per photo entry; the app sums them.
      match /reactions/{rid} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['up', 'mid', 'down', 'source', 'photoId', 'createdBy', 'createdAt'])
          && request.resource.data.up is int && request.resource.data.up >= 0 && request.resource.data.up <= 500
          && request.resource.data.mid is int && request.resource.data.mid >= 0 && request.resource.data.mid <= 500
          && request.resource.data.down is int && request.resource.data.down >= 0 && request.resource.data.down <= 500
          && request.resource.data.source in ['photo', 'tap']
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if isMember();
      }
    }
  }
}
